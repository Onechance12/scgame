{
  "meta": {
    "name": "College Hill — free asset redirect database",
    "purpose": "Curated, mostly-CC0 free asset sources + direct-download URL patterns to pull skins/textures, 3D objects, creatures, sounds, music, VFX, HDRIs, fonts and period documents into the game. 'verified: true' means an endpoint or URL pattern was tested live during this build.",
    "updated": "2026-07",
    "rule": "Prefer CC0 (no attribution, commercial ok). For CC-BY keep the credit in assets/CREDITS.txt. Never commit anything you have not confirmed is free to use."
  },

  "licenses": {
    "CC0": "Public domain dedication. No attribution, any use incl. commercial. Preferred.",
    "CC-BY": "Free incl. commercial, but you MUST credit the author (add to assets/CREDITS.txt).",
    "CC-BY-SA": "Free + credit + derivatives must share-alike. Avoid for mixed projects unless ok.",
    "PD": "Public domain (old enough / gov work). Free to use.",
    "RF-ACCOUNT": "Free but requires a free account / API key / login to download."
  },

  "resolvers": {
    "comment": "URL templates. Substitute {id}, {res} in {1k,2k,4k}, {map} in {diff,nor_gl,rough,ao,disp,arm}, {fmt} in {JPG,PNG}. All verified live.",
    "polyhaven_asset_list": "https://api.polyhaven.com/assets?type={type}    (type = textures|models|hdris)",
    "polyhaven_files": "https://api.polyhaven.com/files/{id}    (returns JSON with every download URL)",
    "polyhaven_texture_map": "https://dl.polyhaven.org/file/ph-assets/Textures/jpg/{res}/{id}/{id}_{map}_{res}.jpg",
    "polyhaven_model_gltf": "https://dl.polyhaven.org/file/ph-assets/Models/gltf/{res}/{id}/{id}_{res}.gltf",
    "polyhaven_hdri": "https://dl.polyhaven.org/file/ph-assets/HDRIs/hdr/{res}/{id}_{res}.hdr",
    "ambientcg_json": "https://ambientcg.com/api/v2/full_json?type=Material&limit={n}&include=downloadData",
    "ambientcg_zip": "https://ambientcg.com/get?file={id}_{res}-{fmt}.zip    (e.g. Rock030_1K-JPG.zip)",
    "sketchfab_cc0_search": "https://api.sketchfab.com/v3/search?type=models&downloadable=true&license=cc0&q={query}&count={n}",
    "freesound_search": "https://freesound.org/apiv2/search/text/?query={q}&filter=license:%22Creative+Commons+0%22&token={FREESOUND_TOKEN}",
    "chronicling_america": "https://chroniclingamerica.loc.gov/search/pages/results/?state=&andtext={q}&format=json    (public-domain US newspapers 1770-1963)"
  },

  "sources": [
